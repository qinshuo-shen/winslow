# Copy this file to .env and fill in real values yourself (never paste secrets
# into chat/conversation — edit .env directly in your editor or terminal).
# .env is gitignored and never committed.

# Notion — from https://www.notion.so/my-integrations (create an "internal
# integration", copy its token). Remember to also share your tasks database
# with the integration (Database -> ... -> Connections), or every API call
# will 404 as if the database doesn't exist.
NOTION_TOKEN=
NOTION_DATABASE_ID=

# Gmail (Phase 3) — from Google Cloud Console, Desktop app OAuth client.
# Not needed for Phase 0/1/2.
# GMAIL_CREDENTIALS_PATH=./credentials.json

# Name of the local macOS calendar this tool writes focus/task blocks to.
# Created automatically if it doesn't already exist.
FOCUS_CALENDAR_NAME=Focus Blocks

# Name of your OWN already-Exchange-synced calendar, exactly as it appears
# in Calendar.app (Calendar.app -> Preferences/sidebar). Used only for
# optional "hardcore" focus sessions (a real calendar block so others see
# you as busy) -- this tool never creates this calendar itself, unlike
# FOCUS_CALENDAR_NAME above. Leave unset if you don't want this feature.
EXCHANGE_CALENDAR_NAME=

# AI PM-agent (Scrum-lite feature set) — from https://console.anthropic.com.
# Optional; the "Review my backlog" panel just won't be usable without it.
# Set PM_AGENT_MOCK=1 during local dev to exercise the full UI with canned
# suggestions and zero cost/API calls, without needing a real key at all.
ANTHROPIC_API_KEY=
PM_AGENT_MODEL=claude-opus-5
PM_AGENT_MOCK=
